FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    g++ \
    git \
    libcairo2-dev \
    libgif-dev \
    libjpeg-dev \
    libpango1.0-dev \
    librsvg2-dev \
    make \
    pkg-config \
    python3 \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY scripts ./scripts

RUN npm ci

ENV XDG_CONFIG_HOME=/app/.config

RUN mkdir -p /app/.config/yt-dlp/plugins \
  && curl -fsSL https://github.com/Brainicism/bgutil-ytdlp-pot-provider/releases/latest/download/bgutil-ytdlp-pot-provider.zip \
    -o /app/.config/yt-dlp/plugins/bgutil-ytdlp-pot-provider.zip \
  && git clone --single-branch --branch 1.3.1 --depth 1 https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /app/bgutil-ytdlp-pot-provider \
  && cd /app/bgutil-ytdlp-pot-provider/server \
  && npm ci \
  && npx tsc \
  && npm cache clean --force

COPY api ./api
COPY src ./src
COPY tsconfig.json ./

RUN chmod +x ./scripts/start-youtube-service.sh

ENV PORT=3200

EXPOSE 3200

CMD ["./scripts/start-youtube-service.sh"]
