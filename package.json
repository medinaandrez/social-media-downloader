{
  "name": "social-media-downloader",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/install-ytdlp.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "android:doctor": "bash scripts/android-doctor.sh",
    "android:devices": "bash scripts/with-android-env.sh adb devices",
    "android:sdk": "bash scripts/android-install-sdk.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "smoke:api": "node scripts/smoke-api.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "api:dev": "tsx scripts/dev-api.ts",
    "youtube:service": "tsx scripts/youtube-resolve-service.ts",
    "server:install-ytdlp": "node scripts/install-ytdlp.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "youtube-dl-exec": "^3.1.6"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@vercel/node": "^5.7.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
