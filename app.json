{
  "expo": {
    "name": "Social Media Downloader",
    "slug": "social-media-downloader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "smdownloader",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071511"
    },
    "ios": {
      "bundleIdentifier": "com.medinaandrez.socialmediadownloader",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Social DL",
        "NSPhotoLibraryUsageDescription": "Social Media Downloader necesita permiso para acceder a tu galeria cuando quieras guardar contenido.",
        "NSPhotoLibraryAddUsageDescription": "Social Media Downloader necesita permiso para guardar videos descargados en tu galeria."
      }
    },
    "android": {
      "package": "com.medinaandrez.socialmediadownloader",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071511"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "https://socialm-downloader.vercel.app",
      "router": {},
      "eas": {
        "projectId": "e41a6693-d219-41f3-9864-e6bccee0e144"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Social Media Downloader necesita permiso para acceder a tu galeria cuando quieras guardar contenido.",
          "savePhotosPermission": "Social Media Downloader necesita permiso para guardar videos descargados en tu galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
